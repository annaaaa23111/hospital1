const form = document.getElementById("appointmentForm");
const successMsg = document.getElementById("successMsg");

const fields = [
  "lastName", "firstName", "middleName", "birthDate",
  "snils", "address", "phone", "doctor", "visitDate", "visitTime"
];

const today = new Date().toISOString().slice(0, 10);
document.getElementById("birthDate").max = today;
document.getElementById("visitDate").min = today;

function showError(id, show) {
  document.getElementById(id).classList.toggle("invalid", show);
  document.getElementById("err-" + id).classList.toggle("show", show);
}

function validate(id) {
  const value = document.getElementById(id).value.trim();
  const checks = {
    lastName: /^[А-Яа-яЁёA-Za-z-]{2,}$/.test(value),
    firstName: /^[А-Яа-яЁёA-Za-z-]{2,}$/.test(value),
    middleName: /^[А-Яа-яЁёA-Za-z-]{2,}$/.test(value),
    birthDate: Boolean(value) && value <= today,
    snils: /^\d{3}-\d{3}-\d{3} \d{2}$/.test(value),
    address: value.length >= 5,
    phone: /^\+7 $\d{3}$ \d{3}-\d{2}-\d{2}$/.test(value),
    doctor: Boolean(value),
    visitDate: Boolean(value) && value >= today,
    visitTime: Boolean(value)
  };

  showError(id, !checks[id]);
  return checks[id];
}

fields.forEach((id) => {
  const input = document.getElementById(id);
  input.addEventListener("blur", () => validate(id));
  input.addEventListener("change", () => validate(id));
});

document.getElementById("snils").addEventListener("input", (event) => {
  const d = event.target.value.replace(/\D/g, "").slice(0, 11);
  event.target.value = d
    .replace(/^(\d{3})(\d)/, "$1-$2")
    .replace(/^(\d{3}-\d{3})(\d)/, "$1-$2")
    .replace(/^(\d{3}-\d{3}-\d{3})(\d)/, "$1 $2");
});

document.getElementById("phone").addEventListener("input", (event) => {
  let d = event.target.value.replace(/\D/g, "");
  if (d.startsWith("8")) d = "7" + d.slice(1);
  if (!d.startsWith("7")) d = "7" + d;
  d = d.slice(0, 11);

  let result = "+7";
  if (d.length > 1) result += " (" + d.slice(1, 4);
  if (d.length >= 5) result += ") " + d.slice(4, 7);
  if (d.length >= 8) result += "-" + d.slice(7, 9);
  if (d.length >= 10) result += "-" + d.slice(9, 11);

  event.target.value = result;
});

form.addEventListener("submit", (event) => {
  event.preventDefault();
  successMsg.classList.remove("show");

  const isValid = fields.map(validate).every(Boolean);

  if (isValid) {
    form.reset();
    successMsg.classList.add("show");
    successMsg.scrollIntoView({ behavior: "smooth", block: "center" });
  }
});
